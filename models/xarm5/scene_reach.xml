<mujoco model="xarm5 reach scene">
  <include file="xarm5.xml"/>

  <statistic center="0.3 0 0.35" extent="0.9"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-140" elevation="-25" offwidth="1280" offheight="720"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4"
      rgb2="0 0 0" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>
    <camera name="front" pos="1.2 0.8 0.9" quat="0.72 0 0.19 0.67"/>
    <camera name="side" pos="-0.3 1.6 0.8" quat="0.66 0.24 0.24 0.67"/>

    <!-- RL reaching target: visual-only sphere moved through the mocap interface
         by src/rl/reach_env.py (no collision, no dynamics). -->
    <body name="target_mocap" mocap="true" pos="0.26 0 0.35">
      <geom name="target_sphere" type="sphere" size="0.015"
        rgba="0.1 0.9 0.1 0.6" contype="0" conaffinity="0"/>
    </body>
  </worldbody>
</mujoco>
