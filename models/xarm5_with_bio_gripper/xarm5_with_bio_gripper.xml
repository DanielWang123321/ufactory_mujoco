    <!-- Bio Gripper G2 Visual OBJs -->
    <mesh name="bio_base_white_vis" file="bio_gripper_g2/visual/bio_gripper_g2_base_white.obj" inertia="shell"/>
    <mesh name="bio_base_silver_vis" file="bio_gripper_g2/visual/bio_gripper_g2_base_silver.obj" inertia="shell"/>
    <mesh name="bio_left_finger_vis" file="bio_gripper_g2/visual/bio_gripper_g2_left_finger.obj" inertia="shell"/>
