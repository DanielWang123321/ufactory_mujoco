    <exclude body1="bio_gripper_g2_base_link" body2="bio_gripper_g2_right_finger"/>
  </contact>

  <equality>
    <joint name="mimic_bio_gripper_g2_left_finger_joint_to_bio_gripper_g2_right_finger_joint"
