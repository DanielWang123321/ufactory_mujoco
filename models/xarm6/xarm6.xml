<mujoco model="xarm6">
  <!-- UFACTORY xArm 6, converted from official xarm_description URDF (xArm-Developer/xarm_ros).
       Inertial / kinematic data preserved from URDF; actuator params follow Menagerie xArm7 convention. -->
  <compiler angle="radian" autolimits="true" meshdir="assets"/>

  <option integrator="implicitfast"/>

  <asset>
    <material name="white" rgba="1 1 1 1"/>
    <material name="gray" rgba="0.753 0.753 0.753 1"/>

    <mesh name="link_base" file="xarm6/visual/link_base.stl"/>
    <mesh name="link1" file="xarm6/visual/link1.stl"/>
    <mesh name="link2" file="xarm6/visual/link2.stl"/>
    <mesh name="link3" file="xarm6/visual/link3.stl"/>
    <mesh name="link4" file="xarm6/visual/link4.stl"/>
    <mesh name="link5" file="xarm6/visual/link5.stl"/>
    <mesh name="link6" file="xarm6/visual/link6.stl"/>
    <mesh name="end_tool" file="end_tool/collision/end_tool.stl"/>
  </asset>

  <default>
    <default class="xarm6">
      <geom type="mesh" material="white"/>
      <joint axis="0 0 1" armature="0.1" range="-6.28319 6.28319" frictionloss="1"/>
      <general biastype="affine" ctrlrange="-6.28319 6.28319"/>
      <default class="size1"><!-- shoulder joints, effort ±50 Nm -->
        <joint damping="10"/>
        <general gainprm="1500" biasprm="0 -1500 -150" forcerange="-50 50"/>
      </default>
      <default class="size2"><!-- elbow / wrist joints, effort ±32 Nm -->
        <joint damping="5"/>
        <general gainprm="1000" biasprm="0 -1000 -100" forcerange="-32 32"/>
      </default>
      <default class="size3"><!-- flange joint, effort ±20 Nm -->
        <joint damping="2"/>
        <general gainprm="800" biasprm="0 -800 -80" forcerange="-20 20"/>
      </default>
      <site size="0.001" rgba="1 0 0 1" group="4"/>
    </default>
  </default>

  <worldbody>
    <body name="link_base" childclass="xarm6">
      <geom mesh="link_base"/>
      <body name="link1" pos="0 0 0.267">
        <inertial pos="0.00022 0.02951 -0.0124" quat="0.976139 -0.216079 -0.00387305 -0.0211673" mass="2.3814"
          diaginertia="0.00585697 0.00544434 0.00312315"/>
        <joint name="joint1" class="size1"/>
        <geom mesh="link1"/>
        <body name="link2" quat="0.707105 -0.707108 0 0">
          <inertial pos="0.03881 -0.22783 0.03496" quat="0.635305 0.753023 0.170976 -0.010531" mass="2.2675"
            diaginertia="0.0294477 0.0281783 0.00383449"/>
          <joint name="joint2" range="-2.059 2.0944" class="size1"/>
          <geom mesh="link2"/>
          <body name="link3" pos="0.0535 -0.2845 0">
            <inertial pos="0.07041 0.11631 0.0107" quat="0.845838 0.425539 -0.293179 0.132369" mass="1.875"
              diaginertia="0.00714132 0.00699471 0.00196753"/>
            <joint name="joint3" range="-3.927 0.19198" class="size2"/>
            <geom mesh="link3"/>
            <body name="link4" pos="0.0775 0.3425 0" quat="0.707105 -0.707108 0 0">
              <inertial pos="-0.00018 0.01798 -0.02291" quat="0.99929 -0.0369702 0.00179429 -0.00701173" mass="1.3192"
                diaginertia="0.00489614 0.00447403 0.00132609"/>
              <joint name="joint4" class="size2"/>
              <geom mesh="link4"/>
              <body name="link5" quat="0.707105 0.707108 0 0">
                <inertial pos="0.0651 0.03096 0.00315" quat="-0.223008 0.771309 0.16027 0.574163" mass="1.33854"
                  diaginertia="0.00241824 0.00213367 0.00108731"/>
                <joint name="joint5" range="-1.69297 3.14159" class="size2"/>
                <geom mesh="link5"/>
                <body name="link6" pos="0.076 0.097 0" quat="0.707105 -0.707108 0 0">
                  <inertial pos="0 -0.00677 -0.01098" quat="0.487612 0.512088 -0.512088 0.487612" mass="0.17"
                    diaginertia="0.000132176 9.3e-05 5.85236e-05"/>
                  <joint name="joint6" class="size3"/>
                  <geom material="gray" mesh="link6" contype="0" conaffinity="0" group="1"/>
                  <!-- flange collision geometry (official end_tool collision mesh), hidden group -->
                  <geom name="flange_collision" material="gray" mesh="end_tool" group="3"/>
                  <!-- TCP: flange center, xArm tool frame -->
                  <site name="attachment_site" pos="0 0 0"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <general name="act1" joint="joint1" class="size1"/>
    <general name="act2" joint="joint2" class="size1" ctrlrange="-2.059 2.0944"/>
    <general name="act3" joint="joint3" class="size2" ctrlrange="-3.927 0.19198"/>
    <general name="act4" joint="joint4" class="size2"/>
    <general name="act5" joint="joint5" class="size2" ctrlrange="-1.69297 3.14159"/>
    <general name="act6" joint="joint6" class="size3"/>
  </actuator>

  <keyframe>
    <key name="home" qpos="0 0 0 0 0 0" ctrl="0 0 0 0 0 0"/>
    <key name="ready" qpos="0 -0.8 -1.2 1.0 0.3 0" ctrl="0 -0.8 -1.2 1.0 0.3 0"/>
  </keyframe>
</mujoco>
