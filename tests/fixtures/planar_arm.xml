<mujoco model="planar_arm">
  <!-- Synthetic 2-joint planar arm + disk obstacle for collision/planning tests.
       Calibrated states (tests/test_collision.py):
         q=[0, 0]        links driven through the disk (penetration ~0.12 m)
         q=[0.2, 0.4]    passes the disk with ~17 mm gap
         q=[1.2, -0.6] / q=[-1.2, 0.6]  folded, collision-free -->
  <compiler angle="radian"/>
  <worldbody>
    <body name="base" pos="0 0 0.1">
      <joint name="j1" type="hinge" axis="0 0 1" range="-3.14 3.14"/>
      <geom name="l1" type="capsule" fromto="0 0 0 0.3 0 0" size="0.03" rgba="0.3 0.5 0.8 1"/>
      <body name="elbow" pos="0.3 0 0">
        <joint name="j2" type="hinge" axis="0 0 1" range="-3.14 3.14"/>
        <geom name="l2" type="capsule" fromto="0 0 0 0.3 0 0" size="0.03" rgba="0.3 0.5 0.8 1"/>
      </body>
    </body>
    <body name="disk" pos="0.45 0 0.1">
      <geom name="disk_geom" type="sphere" size="0.09" rgba="0.9 0.2 0.2 1"/>
    </body>
  </worldbody>
  <actuator>
    <general name="act1" joint="j1" gainprm="1" biasprm="0 -1 0"/>
    <general name="act2" joint="j2" gainprm="1" biasprm="0 -1 0"/>
  </actuator>
</mujoco>
