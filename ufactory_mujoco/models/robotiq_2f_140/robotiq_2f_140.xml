          <geom class="rq140_visual" mesh="robotiq_2f_140_right_finger_dark_vis" material="robotiq_black"/>
          <geom class="rq140_visual" mesh="robotiq_2f_140_right_finger_silver_vis" material="robotiq_silver"/>
          <geom class="rq140_pad" mesh="robotiq_2f_140_right_finger_pad"/>
          <geom class="rq140_collision" mesh="robotiq_2f_140_right_finger_body"/>
        </body>
      </body>
      <body name="robotiq_2f_140_right_inner_knuckle" pos="0 -0.0127 0.061178">
        <inertial pos="0 -0.035558 0.039592" mass="0.068112" fullinertia="4.53847e-05 3.28597e-05 2.55428e-05 5.08846e-08 1.15833e-08 2.15828e-05"/>
