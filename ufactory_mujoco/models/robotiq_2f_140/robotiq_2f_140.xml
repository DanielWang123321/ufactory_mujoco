          <joint name="robotiq_2f_140_left_finger_joint" axis="-1 0 0" class="rq140_jnt"/>
          <geom class="rq140_visual" mesh="robotiq_2f_140_left_finger_dark_vis" material="robotiq_black"/>
          <geom class="rq140_visual" mesh="robotiq_2f_140_left_finger_silver_vis" material="robotiq_silver"/>
          <geom class="rq140_pad" mesh="robotiq_2f_140_left_finger_pad"/>
          <geom class="rq140_collision" mesh="robotiq_2f_140_left_finger_body"/>
        </body>
      </body>
      <body name="robotiq_2f_140_left_inner_knuckle" pos="0 0.0127 0.061178">
        <inertial pos="0 0.035558 0.039592" mass="0.068112" fullinertia="4.53847e-05 3.28597e-05 2.55428e-05 -5.08846e-08 1.15833e-08 -2.15828e-05"/>
        <joint name="robotiq_2f_140_left_inner_knuckle_joint" axis="1 0 0" class="rq140_jnt"/>
        <geom class="rq140_visual" mesh="robotiq_2f_140_left_inner_knuckle_vis" material="robotiq_black"/>
        <geom class="rq140_collision" mesh="robotiq_2f_140_left_inner_knuckle_col"/>
      </body>

      <!-- Right finger chain -->
      <body name="robotiq_2f_140_right_outer_knuckle" pos="0 -0.030601 0.054663">
        <inertial pos="-2.68e-06 -0.04357638 0.02633231" mass="0.086227" fullinertia="6.64688691e-05 5.40415039e-05 2.44819983e-05 -6.06033761e-10 8.56259119e-10 2.78519659e-05"/>
        <joint name="robotiq_2f_140_right_outer_knuckle_joint" axis="-1 0 0" class="rq140_jnt"/>
        <geom class="rq140_visual" mesh="robotiq_2f_140_right_outer_knuckle_silver_vis" material="robotiq_silver"/>
        <geom class="rq140_visual" mesh="robotiq_2f_140_right_outer_knuckle_dark_vis" material="robotiq_black"/>
        <geom class="rq140_collision" mesh="robotiq_2f_140_right_outer_knuckle_col_0"/>
        <geom class="rq140_collision" mesh="robotiq_2f_140_right_outer_finger_col_1"/>
        <body name="robotiq_2f_140_right_finger" pos="0 -0.066855 0.074366">
          <inertial pos="5.5e-07 0.01667953 0.03894517" mass="0.089834" fullinertia="3.8101843e-05 4.04906481e-05 7.44695497e-06 -5.74065035e-09 -9.49924727e-09 -3.92615878e-06"/>
