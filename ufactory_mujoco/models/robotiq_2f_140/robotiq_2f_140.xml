  <contact>
    <exclude body1="robotiq_2f_140_base_link" body2="robotiq_2f_140_left_outer_knuckle"/>
    <exclude body1="robotiq_2f_140_base_link" body2="robotiq_2f_140_left_inner_knuckle"/>
    <exclude body1="robotiq_2f_140_base_link" body2="robotiq_2f_140_right_outer_knuckle"/>
    <exclude body1="robotiq_2f_140_base_link" body2="robotiq_2f_140_right_inner_knuckle"/>
    <exclude body1="robotiq_2f_140_left_inner_knuckle" body2="robotiq_2f_140_left_outer_knuckle"/>
    <exclude body1="robotiq_2f_140_left_inner_knuckle" body2="robotiq_2f_140_left_finger"/>
    <exclude body1="robotiq_2f_140_right_inner_knuckle" body2="robotiq_2f_140_right_outer_knuckle"/>
    <exclude body1="robotiq_2f_140_right_inner_knuckle" body2="robotiq_2f_140_right_finger"/>
  </contact>

  <!-- Stiff couplings keep the pads parallel under the full pinch force. -->
  <equality>
    <joint joint1="robotiq_2f_140_drive_joint" joint2="robotiq_2f_140_left_finger_joint" polycoef="0 1 0 0 0" solref="0.004 1" solimp="0.9999 0.9999 0.001 0.5 2"/>
    <joint joint1="robotiq_2f_140_drive_joint" joint2="robotiq_2f_140_left_inner_knuckle_joint" polycoef="0 1 0 0 0" solref="0.004 1" solimp="0.9999 0.9999 0.001 0.5 2"/>
    <joint joint1="robotiq_2f_140_drive_joint" joint2="robotiq_2f_140_right_outer_knuckle_joint" polycoef="0 1 0 0 0" solref="0.004 1" solimp="0.9999 0.9999 0.001 0.5 2"/>
    <joint joint1="robotiq_2f_140_drive_joint" joint2="robotiq_2f_140_right_finger_joint" polycoef="0 1 0 0 0" solref="0.004 1" solimp="0.9999 0.9999 0.001 0.5 2"/>
    <joint joint1="robotiq_2f_140_drive_joint" joint2="robotiq_2f_140_right_inner_knuckle_joint" polycoef="0 1 0 0 0" solref="0.004 1" solimp="0.9999 0.9999 0.001 0.5 2"/>
  </equality>

  <actuator>
    <position name="robotiq_2f_140_motor" joint="robotiq_2f_140_drive_joint" kp="120" kv="10" forcerange="-23.721543379318 23.721543379318" ctrlrange="0.0038593285902723817 0.7665940156296729"/>
  </actuator>

  <keyframe>
    <key name="open" qpos="0.0038593285902723817 0.0038593285902723817 0.0038593285902723817 0.0038593285902723817 0.0038593285902723817 0.0038593285902723817" ctrl="0.0038593285902723817"/>
    <key name="close" qpos="0.7665940156296729 0.7665940156296729 0.7665940156296729 0.7665940156296729 0.7665940156296729 0.7665940156296729" ctrl="0.7665940156296729"/>
