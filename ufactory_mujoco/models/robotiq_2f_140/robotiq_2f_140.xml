<mujoco model="robotiq_2f_140">
  <!-- Robotiq 2F-140 parallel/adaptive gripper (0..140 mm jaw gap, 1.00 kg, 11-hull collision STLs). -->
  <compiler angle="radian" autolimits="true" meshdir="assets"/>

  <option integrator="implicitfast"/>

  <asset>
