    <mesh name="robotiq_2f_140_left_outer_knuckle_col_0" file="robotiq_2f_140/collision/robotiq_2f_140_left_outer_knuckle_col_0.stl"/>
    <mesh name="robotiq_2f_140_left_outer_finger_col_1" file="robotiq_2f_140/collision/robotiq_2f_140_left_outer_finger_col_1.stl"/>
    <mesh name="robotiq_2f_140_left_finger_pad" file="robotiq_2f_140/collision/robotiq_2f_140_left_finger_pad.stl"/>
    <mesh name="robotiq_2f_140_left_finger_body" file="robotiq_2f_140/collision/robotiq_2f_140_left_finger_body.stl"/>
    <mesh name="robotiq_2f_140_left_inner_knuckle_col" file="robotiq_2f_140/collision/robotiq_2f_140_left_inner_knuckle.stl"/>
    <mesh name="robotiq_2f_140_right_outer_knuckle_col_0" file="robotiq_2f_140/collision/robotiq_2f_140_right_outer_knuckle_col_0.stl"/>
    <mesh name="robotiq_2f_140_right_outer_finger_col_1" file="robotiq_2f_140/collision/robotiq_2f_140_right_outer_finger_col_1.stl"/>
    <mesh name="robotiq_2f_140_right_finger_pad" file="robotiq_2f_140/collision/robotiq_2f_140_right_finger_pad.stl"/>
    <mesh name="robotiq_2f_140_right_finger_body" file="robotiq_2f_140/collision/robotiq_2f_140_right_finger_body.stl"/>
    <mesh name="robotiq_2f_140_right_inner_knuckle_col" file="robotiq_2f_140/collision/robotiq_2f_140_right_inner_knuckle.stl"/>
  </asset>

  <default>
    <default class="rq140">
      <default class="rq140_visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2"/>
      </default>
      <default class="rq140_collision">
        <geom type="mesh" group="3"/>
        <default class="rq140_pad">
          <geom priority="1" solref="0.004 1" solimp="0.95 0.99 0.001 0.5 2"/>
        </default>
      </default>
      <default class="rq140_jnt">
        <joint range="0.0038593285902723817 0.7665940156296729" armature="0.02" damping="0.1" frictionloss="0" solreflimit="0.005 1"/>
      </default>
    </default>
  </default>

  <worldbody>
    <body name="robotiq_2f_140_base_link" pos="0 0 0.29" quat="0 1 0 0" childclass="rq140">
      <inertial pos="0 0 0.03145" mass="0.511654" fullinertia="0.00045186466 0.000402781835 0.000304435485 -6.0109124e-21 0 0"/>
      <geom class="rq140_visual" mesh="robotiq_2f_140_base_dark_vis" material="robotiq_dark_metal"/>
      <geom class="rq140_visual" mesh="robotiq_2f_140_base_silver_vis" material="robotiq_silver"/>
      <geom class="rq140_collision" mesh="robotiq_2f_140_base_col_00"/>

      <!-- Left finger chain -->
      <body name="robotiq_2f_140_left_outer_knuckle" pos="0 0.030601 0.054663">
        <inertial pos="-2.68e-06 0.04357638 0.02633231" mass="0.086227" fullinertia="6.64688691e-05 5.40415039e-05 2.44819983e-05 6.06033761e-10 8.56259119e-10 -2.78519659e-05"/>
        <joint name="robotiq_2f_140_drive_joint" axis="1 0 0" class="rq140_jnt"/>
        <geom class="rq140_visual" mesh="robotiq_2f_140_left_outer_knuckle_silver_vis" material="robotiq_silver"/>
        <geom class="rq140_visual" mesh="robotiq_2f_140_left_outer_knuckle_dark_vis" material="robotiq_black"/>
