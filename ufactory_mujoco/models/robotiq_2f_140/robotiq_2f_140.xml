    <material name="robotiq_silver" rgba="0.78 0.79 0.80 1" specular="0.80" shininess="0.35" reflectance="0.04" metallic="0.80" roughness="0.42"/>

    <!-- Visual OBJs -->
    <mesh name="robotiq_2f_140_base_dark_vis" file="robotiq_2f_140/visual/base_dark.obj" inertia="shell"/>
    <mesh name="robotiq_2f_140_base_silver_vis" file="robotiq_2f_140/visual/base_silver.obj" inertia="shell"/>
    <mesh name="robotiq_2f_140_left_outer_knuckle_dark_vis" file="robotiq_2f_140/visual/left_outer_knuckle_dark.obj" inertia="shell"/>
