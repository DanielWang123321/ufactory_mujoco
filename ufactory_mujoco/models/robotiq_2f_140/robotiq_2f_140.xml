    <mesh name="robotiq_2f_140_left_finger_silver_vis" file="robotiq_2f_140/visual/left_finger_silver.obj" inertia="shell"/>
    <mesh name="robotiq_2f_140_left_inner_knuckle_vis" file="robotiq_2f_140/visual/left_inner_knuckle.obj" inertia="shell"/>
    <mesh name="robotiq_2f_140_right_outer_knuckle_dark_vis" file="robotiq_2f_140/visual/right_outer_knuckle_dark.obj" inertia="shell"/>
    <mesh name="robotiq_2f_140_right_outer_knuckle_silver_vis" file="robotiq_2f_140/visual/right_outer_knuckle_silver.obj" inertia="shell"/>
    <mesh name="robotiq_2f_140_right_finger_dark_vis" file="robotiq_2f_140/visual/right_finger_dark.obj" inertia="shell"/>
    <mesh name="robotiq_2f_140_right_finger_silver_vis" file="robotiq_2f_140/visual/right_finger_silver.obj" inertia="shell"/>
