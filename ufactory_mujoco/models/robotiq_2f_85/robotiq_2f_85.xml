<mujoco model="robotiq_2f_85">
  <!-- Robotiq 2F-85 parallel/adaptive gripper (0..85 mm jaw gap, 0.92 kg, 11-hull collision STLs). -->
  <compiler angle="radian" autolimits="true" meshdir="assets"/>

  <option integrator="implicitfast"/>

  <asset>
    <material name="robotiq_dark_metal" rgba="0.12 0.12 0.13 1" specular="0.45" shininess="0.22" reflectance="0.02" metallic="0.45" roughness="0.48"/>
    <material name="robotiq_black" rgba="0.11 0.11 0.12 1" specular="0.25" shininess="0.15" metallic="0.05" roughness="0.65"/>
    <material name="robotiq_silver" rgba="0.78 0.79 0.80 1" specular="0.80" shininess="0.35" reflectance="0.04" metallic="0.80" roughness="0.42"/>

    <!-- Visual OBJs -->
    <mesh name="robotiq_2f_85_base_dark_vis" file="robotiq_2f_85/visual/base_dark.obj" inertia="shell"/>
    <mesh name="robotiq_2f_85_base_silver_vis" file="robotiq_2f_85/visual/base_silver.obj" inertia="shell"/>
    <mesh name="robotiq_2f_85_left_outer_knuckle_dark_vis" file="robotiq_2f_85/visual/left_outer_knuckle_dark.obj" inertia="shell"/>
    <mesh name="robotiq_2f_85_left_outer_knuckle_silver_vis" file="robotiq_2f_85/visual/left_outer_knuckle_silver.obj" inertia="shell"/>
    <mesh name="robotiq_2f_85_left_finger_dark_vis" file="robotiq_2f_85/visual/left_finger_dark.obj" inertia="shell"/>
    <mesh name="robotiq_2f_85_left_finger_silver_vis" file="robotiq_2f_85/visual/left_finger_silver.obj" inertia="shell"/>
    <mesh name="robotiq_2f_85_left_inner_knuckle_dark_vis" file="robotiq_2f_85/visual/left_inner_knuckle_dark.obj" inertia="shell"/>
    <mesh name="robotiq_2f_85_left_inner_knuckle_silver_vis" file="robotiq_2f_85/visual/left_inner_knuckle_silver.obj" inertia="shell"/>
    <mesh name="robotiq_2f_85_right_outer_knuckle_dark_vis" file="robotiq_2f_85/visual/right_outer_knuckle_dark.obj" inertia="shell"/>
    <mesh name="robotiq_2f_85_right_outer_knuckle_silver_vis" file="robotiq_2f_85/visual/right_outer_knuckle_silver.obj" inertia="shell"/>
    <mesh name="robotiq_2f_85_right_finger_dark_vis" file="robotiq_2f_85/visual/right_finger_dark.obj" inertia="shell"/>
    <mesh name="robotiq_2f_85_right_finger_silver_vis" file="robotiq_2f_85/visual/right_finger_silver.obj" inertia="shell"/>
    <mesh name="robotiq_2f_85_right_inner_knuckle_dark_vis" file="robotiq_2f_85/visual/right_inner_knuckle_dark.obj" inertia="shell"/>
    <mesh name="robotiq_2f_85_right_inner_knuckle_silver_vis" file="robotiq_2f_85/visual/right_inner_knuckle_silver.obj" inertia="shell"/>

    <!-- Collision STLs -->
    <mesh name="robotiq_2f_85_base_col_00" file="robotiq_2f_85/collision/robotiq_2f_85_base_col_00.stl"/>
    <mesh name="robotiq_2f_85_left_outer_knuckle_col_0" file="robotiq_2f_85/collision/robotiq_2f_85_left_outer_knuckle_col_0.stl"/>
    <mesh name="robotiq_2f_85_left_outer_finger_col_1" file="robotiq_2f_85/collision/robotiq_2f_85_left_outer_finger_col_1.stl"/>
    <mesh name="robotiq_2f_85_left_finger_pad" file="robotiq_2f_85/collision/robotiq_2f_85_left_finger_pad.stl"/>
    <mesh name="robotiq_2f_85_left_finger_body" file="robotiq_2f_85/collision/robotiq_2f_85_left_finger_body.stl"/>
    <mesh name="robotiq_2f_85_left_inner_knuckle_col" file="robotiq_2f_85/collision/robotiq_2f_85_left_inner_knuckle.stl"/>
    <mesh name="robotiq_2f_85_right_outer_knuckle_col_0" file="robotiq_2f_85/collision/robotiq_2f_85_right_outer_knuckle_col_0.stl"/>
    <mesh name="robotiq_2f_85_right_outer_finger_col_1" file="robotiq_2f_85/collision/robotiq_2f_85_right_outer_finger_col_1.stl"/>
    <mesh name="robotiq_2f_85_right_finger_pad" file="robotiq_2f_85/collision/robotiq_2f_85_right_finger_pad.stl"/>
    <mesh name="robotiq_2f_85_right_finger_body" file="robotiq_2f_85/collision/robotiq_2f_85_right_finger_body.stl"/>
    <mesh name="robotiq_2f_85_right_inner_knuckle_col" file="robotiq_2f_85/collision/robotiq_2f_85_right_inner_knuckle.stl"/>
  </asset>

  <default>
    <default class="rq85">
      <default class="rq85_visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2"/>
      </default>
      <default class="rq85_collision">
        <geom type="mesh" group="3"/>
        <default class="rq85_pad">
          <geom priority="1" solref="0.004 1" solimp="0.95 0.99 0.001 0.5 2"/>
        </default>
      </default>
      <default class="rq85_jnt">
        <joint range="0 0.8014334346423151" armature="0.02" damping="0.1" frictionloss="0" solreflimit="0.005 1"/>
      </default>
    </default>
  </default>

  <worldbody>
    <body name="robotiq_2f_85_base_link" pos="0 0 0.22" quat="0 1 0 0" childclass="rq85">
      <inertial pos="-2.274e-05 0 0.03232288" mass="0.66320197" fullinertia="0.00058802208 0.00051617816 0.00039462776 -2.936e-08 3.2296e-07 -1.97755965e-23"/>
      <geom class="rq85_visual" mesh="robotiq_2f_85_base_dark_vis" material="robotiq_dark_metal"/>
      <geom class="rq85_visual" mesh="robotiq_2f_85_base_silver_vis" material="robotiq_silver"/>
      <geom class="rq85_collision" mesh="robotiq_2f_85_base_col_00"/>

      <!-- Left finger chain -->
      <body name="robotiq_2f_85_left_outer_knuckle" pos="0 0.03060114 0.05490452">
        <inertial pos="0.00055052 0.02938674 0.01110696" mass="0.0564515" fullinertia="2.21233737e-05 1.67295143e-05 1.29013306e-05 -2.37618088e-07 -1.61032042e-07 -5.7573776e-06"/>
        <joint name="robotiq_2f_85_drive_joint" axis="1 0 0" class="rq85_jnt"/>
        <geom class="rq85_visual" mesh="robotiq_2f_85_left_outer_knuckle_silver_vis" material="robotiq_silver"/>
        <geom class="rq85_visual" mesh="robotiq_2f_85_left_outer_knuckle_dark_vis" material="robotiq_black"/>
        <geom class="rq85_collision" mesh="robotiq_2f_85_left_outer_knuckle_col_0"/>
        <geom class="rq85_collision" mesh="robotiq_2f_85_left_outer_finger_col_1"/>
        <body name="robotiq_2f_85_left_finger" pos="0 0.0371575 0.04342168">
          <inertial pos="0.0008 -0.01456706 0.01649701" mass="0.04268589" fullinertia="1.197888e-05 1.048152e-05 4.22784e-06 -9.16868566e-23 2.1573378e-22 3.5232e-06"/>
          <joint name="robotiq_2f_85_left_finger_joint" axis="-1 0 0" class="rq85_jnt"/>
          <geom class="rq85_visual" mesh="robotiq_2f_85_left_finger_dark_vis" material="robotiq_black"/>
          <geom class="rq85_visual" mesh="robotiq_2f_85_left_finger_silver_vis" material="robotiq_silver"/>
          <geom class="rq85_pad" mesh="robotiq_2f_85_left_finger_pad"/>
          <geom class="rq85_collision" mesh="robotiq_2f_85_left_finger_body"/>
        </body>
      </body>
      <body name="robotiq_2f_85_left_inner_knuckle" pos="0 0.0127 0.06142">
        <inertial pos="-0.00015001 0.01897699 0.02247101" mass="0.02969376" fullinertia="8.69056e-06 9.57136e-06 8.19144e-06 5.3933445e-23 -2.40902721e-22 -3.93424e-06"/>
        <joint name="robotiq_2f_85_left_inner_knuckle_joint" axis="1 0 0" class="rq85_jnt"/>
        <geom class="rq85_visual" mesh="robotiq_2f_85_left_inner_knuckle_dark_vis" material="robotiq_black"/>
        <geom class="rq85_visual" mesh="robotiq_2f_85_left_inner_knuckle_silver_vis" material="robotiq_silver"/>
        <geom class="rq85_collision" mesh="robotiq_2f_85_left_inner_knuckle_col"/>
      </body>

      <!-- Right finger chain -->
      <body name="robotiq_2f_85_right_outer_knuckle" pos="0 -0.03060114 0.05490452">
        <inertial pos="-4.489e-05 -0.02938674 0.01110696" mass="0.0564515" fullinertia="2.21233737e-05 1.67196202e-05 1.28914365e-05 4.91092196e-08 -3.32809593e-08 5.7573776e-06"/>
        <joint name="robotiq_2f_85_right_outer_knuckle_joint" axis="-1 0 0" class="rq85_jnt"/>
        <geom class="rq85_visual" mesh="robotiq_2f_85_right_outer_knuckle_silver_vis" material="robotiq_silver"/>
        <geom class="rq85_visual" mesh="robotiq_2f_85_right_outer_knuckle_dark_vis" material="robotiq_black"/>
        <geom class="rq85_collision" mesh="robotiq_2f_85_right_outer_knuckle_col_0"/>
        <geom class="rq85_collision" mesh="robotiq_2f_85_right_outer_finger_col_1"/>
        <body name="robotiq_2f_85_right_finger" pos="0 -0.0371575 0.04342168">
          <inertial pos="-5e-05 0.01456706 0.01649701" mass="0.04268589" fullinertia="1.197888e-05 1.048152e-05 4.22784e-06 -9.16868566e-23 -2.1573378e-22 -3.5232e-06"/>
          <joint name="robotiq_2f_85_right_finger_joint" axis="1 0 0" class="rq85_jnt"/>
          <geom class="rq85_visual" mesh="robotiq_2f_85_right_finger_dark_vis" material="robotiq_black"/>
          <geom class="rq85_visual" mesh="robotiq_2f_85_right_finger_silver_vis" material="robotiq_silver"/>
          <geom class="rq85_pad" mesh="robotiq_2f_85_right_finger_pad"/>
          <geom class="rq85_collision" mesh="robotiq_2f_85_right_finger_body"/>
        </body>
      </body>
      <body name="robotiq_2f_85_right_inner_knuckle" pos="0 -0.0127 0.06142">
        <inertial pos="-5.001e-05 -0.01926824 0.02222178" mass="0.02969376" fullinertia="8.69056e-06 9.42456e-06 8.33824e-06 4.49445375e-23 2.42700503e-22 3.9636e-06"/>
        <joint name="robotiq_2f_85_right_inner_knuckle_joint" axis="-1 0 0" class="rq85_jnt"/>
        <geom class="rq85_visual" mesh="robotiq_2f_85_right_inner_knuckle_dark_vis" material="robotiq_black"/>
        <geom class="rq85_visual" mesh="robotiq_2f_85_right_inner_knuckle_silver_vis" material="robotiq_silver"/>
        <geom class="rq85_collision" mesh="robotiq_2f_85_right_inner_knuckle_col"/>
      </body>

      <site name="link_tcp" pos="0 0 0.162253"/>
    </body>
  </worldbody>

  <contact>
    <exclude body1="robotiq_2f_85_base_link" body2="robotiq_2f_85_left_outer_knuckle"/>
    <exclude body1="robotiq_2f_85_base_link" body2="robotiq_2f_85_left_inner_knuckle"/>
    <exclude body1="robotiq_2f_85_base_link" body2="robotiq_2f_85_right_outer_knuckle"/>
    <exclude body1="robotiq_2f_85_base_link" body2="robotiq_2f_85_right_inner_knuckle"/>
    <exclude body1="robotiq_2f_85_left_inner_knuckle" body2="robotiq_2f_85_left_outer_knuckle"/>
    <exclude body1="robotiq_2f_85_left_inner_knuckle" body2="robotiq_2f_85_left_finger"/>
    <exclude body1="robotiq_2f_85_right_inner_knuckle" body2="robotiq_2f_85_right_outer_knuckle"/>
    <exclude body1="robotiq_2f_85_right_inner_knuckle" body2="robotiq_2f_85_right_finger"/>
  </contact>

  <!-- Stiff couplings keep the pads parallel under the full pinch force. -->
  <equality>
    <joint joint1="robotiq_2f_85_drive_joint" joint2="robotiq_2f_85_left_finger_joint" polycoef="0 1 0 0 0" solref="0.004 1" solimp="0.9999 0.9999 0.001 0.5 2"/>
    <joint joint1="robotiq_2f_85_drive_joint" joint2="robotiq_2f_85_left_inner_knuckle_joint" polycoef="0 1 0 0 0" solref="0.004 1" solimp="0.9999 0.9999 0.001 0.5 2"/>
    <joint joint1="robotiq_2f_85_drive_joint" joint2="robotiq_2f_85_right_outer_knuckle_joint" polycoef="0 1 0 0 0" solref="0.004 1" solimp="0.9999 0.9999 0.001 0.5 2"/>
    <joint joint1="robotiq_2f_85_drive_joint" joint2="robotiq_2f_85_right_finger_joint" polycoef="0 1 0 0 0" solref="0.004 1" solimp="0.9999 0.9999 0.001 0.5 2"/>
    <joint joint1="robotiq_2f_85_drive_joint" joint2="robotiq_2f_85_right_inner_knuckle_joint" polycoef="0 1 0 0 0" solref="0.004 1" solimp="0.9999 0.9999 0.001 0.5 2"/>
  </equality>

  <actuator>
    <position name="robotiq_2f_85_motor" joint="robotiq_2f_85_drive_joint" kp="120" kv="10" forcerange="-25.798990441801 25.798990441801" ctrlrange="0 0.8014334346423151"/>
  </actuator>

  <keyframe>
    <key name="open" qpos="0 0 0 0 0 0" ctrl="0"/>
    <key name="close" qpos="0.8014334346423151 0.8014334346423151 0.8014334346423151 0.8014334346423151 0.8014334346423151 0.8014334346423151" ctrl="0.8014334346423151"/>
  </keyframe>
</mujoco>
