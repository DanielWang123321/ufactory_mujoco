<mujoco model="xarm6">
  <!-- UFACTORY xArm 6 (1305 variant), high-fidelity multi-material visual OBJs with multi-convex collision STLs. -->
  <compiler angle="radian" autolimits="true" meshdir="assets"/>

  <option integrator="implicitfast"/>

  <asset>
    <!-- Materials -->
    <material name="white" rgba="0.95 0.95 0.95 1" specular="0.4" shininess="0.3"/>
    <material name="silver" rgba="0.85 0.85 0.88 1" specular="0.9" shininess="0.8" reflectance="0.05"/>
    <material name="black" rgba="0.25 0.25 0.25 1" specular="0.2" shininess="0.1"/>
    <material name="seal" rgba="0.8 0.82 0.85 1" specular="0.3" shininess="0.2"/>
    <material name="gray" rgba="0.753 0.753 0.753 1"/>

    <!-- High-fidelity visual OBJs -->
    <mesh name="link_base_vis" file="xarm6/visual/link_base.obj"/>
    <mesh name="link1_seal_vis" file="xarm6/visual/link1_seal.obj" inertia="shell"/>
    <mesh name="link1_white_vis" file="xarm6/visual/link1_white.obj"/>
    <mesh name="link1_silver_vis" file="xarm6/visual/link1_silver.obj"/>
    <mesh name="link2_white_vis" file="xarm6/visual/link2_white.obj"/>
    <mesh name="link2_silver_vis" file="xarm6/visual/link2_silver.obj"/>
    <mesh name="link3_white_vis" file="xarm6/visual/link3_white.obj"/>
    <mesh name="link3_silver_vis" file="xarm6/visual/link3_silver.obj"/>
    <mesh name="link4_white_vis" file="xarm6/visual/link4_white.obj"/>
    <mesh name="link4_silver_vis" file="xarm6/visual/link4_silver.obj" inertia="shell"/>
    <mesh name="link5_white_vis" file="xarm6/visual/link5_white.obj"/>
    <mesh name="link5_silver_vis" file="xarm6/visual/link5_silver.obj"/>
    <mesh name="link6_white_vis" file="xarm6/visual/link6_white.obj" inertia="shell"/>
    <mesh name="link6_black_vis" file="xarm6/visual/link6_black.obj" inertia="shell"/>
    <mesh name="link6_silver_vis" file="xarm6/visual/link6_silver.obj" inertia="shell"/>

    <!-- Multi-convex collision STLs -->
    <mesh name="xarm6_link1_col_00" file="xarm6/collision/xarm6_link1_col_00.stl"/>
    <mesh name="xarm6_link1_col_01" file="xarm6/collision/xarm6_link1_col_01.stl"/>
    <mesh name="xarm6_link2_col_00" file="xarm6/collision/xarm6_link2_col_00.stl"/>
    <mesh name="xarm6_link2_col_01" file="xarm6/collision/xarm6_link2_col_01.stl"/>
    <mesh name="xarm6_link2_col_02" file="xarm6/collision/xarm6_link2_col_02.stl"/>
    <mesh name="xarm6_link2_col_03" file="xarm6/collision/xarm6_link2_col_03.stl"/>
    <mesh name="xarm6_link2_col_04" file="xarm6/collision/xarm6_link2_col_04.stl"/>
    <mesh name="xarm6_link3_col_00" file="xarm6/collision/xarm6_link3_col_00.stl"/>
    <mesh name="xarm6_link3_col_01" file="xarm6/collision/xarm6_link3_col_01.stl"/>
    <mesh name="xarm6_link3_col_02" file="xarm6/collision/xarm6_link3_col_02.stl"/>
    <mesh name="xarm6_link3_col_03" file="xarm6/collision/xarm6_link3_col_03.stl"/>
    <mesh name="xarm6_link3_col_04" file="xarm6/collision/xarm6_link3_col_04.stl"/>
    <mesh name="xarm6_link4_col_00" file="xarm6/collision/xarm6_link4_col_00.stl"/>
    <mesh name="xarm6_link4_col_01" file="xarm6/collision/xarm6_link4_col_01.stl"/>
    <mesh name="xarm6_link4_col_02" file="xarm6/collision/xarm6_link4_col_02.stl"/>
    <mesh name="xarm6_link4_col_03" file="xarm6/collision/xarm6_link4_col_03.stl"/>
    <mesh name="xarm6_link4_col_04" file="xarm6/collision/xarm6_link4_col_04.stl"/>
    <mesh name="xarm6_link5_col_00" file="xarm6/collision/xarm6_link5_col_00.stl"/>
    <mesh name="xarm6_link5_col_01" file="xarm6/collision/xarm6_link5_col_01.stl"/>
    <mesh name="xarm6_link6_col_00" file="xarm6/collision/xarm6_link6_col_00.stl"/>
    <mesh name="xarm6_link_base_col_00" file="xarm6/collision/xarm6_link_base_col_00.stl"/>
    <mesh name="xarm6_link_base_col_01" file="xarm6/collision/xarm6_link_base_col_01.stl"/>
  </asset>

  <default>
    <default class="xarm6">
      <joint axis="0 0 1" armature="0.1" range="-6.28319 6.28319" frictionloss="1"/>
      <general biastype="affine" ctrlrange="-6.28319 6.28319"/>
      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2"/>
      </default>
      <default class="collision">
        <geom type="mesh" group="3"/>
      </default>
      <!-- per-joint torque limits follow the official UFACTORY spec, set as forcerange on each actuator -->
      <default class="size1"><!-- shoulder joints -->
        <joint damping="10"/>
        <general gainprm="1500" biasprm="0 -1500 -150"/>
      </default>
      <default class="size2"><!-- elbow / wrist joints -->
        <joint damping="5"/>
        <general gainprm="1000" biasprm="0 -1000 -100"/>
      </default>
      <default class="size3"><!-- flange joint -->
        <joint damping="2"/>
        <general gainprm="800" biasprm="0 -800 -80"/>
      </default>
      <site size="0.001" rgba="1 0 0 1" group="4"/>
    </default>
  </default>

  <worldbody>
    <body name="link_base" childclass="xarm6">
      <inertial pos="0 0 0.09103" mass="2.7" fullinertia="0.00494875 0.00494174 0.002219 -3.5e-06 1.25e-05 1.67e-06"/>
      <geom class="visual" mesh="link_base_vis" material="silver"/>
      <geom class="collision" mesh="xarm6_link_base_col_00"/>
      <geom class="collision" mesh="xarm6_link_base_col_01"/>
      <body name="link1" pos="0 0 0.267">
        <inertial pos="-0.00017 0.03575 -0.00647" mass="2.531"
          fullinertia="0.005645 0.0038 0.004567 -2.2e-05 0 -0.000597"/>
        <joint name="joint1" class="size1"/>
        <geom class="visual" mesh="link1_white_vis" material="white"/>
        <geom class="visual" mesh="link1_silver_vis" material="silver"/>
        <geom class="visual" mesh="link1_seal_vis" material="seal"/>
        <geom class="collision" mesh="xarm6_link1_col_00"/>
        <geom class="collision" mesh="xarm6_link1_col_01"/>
        <body name="link2" quat="0.707105 -0.707108 0 0">
          <inertial pos="0.04084 -0.2403 0.0324" mass="2.242"
            fullinertia="0.023006 0.005974 0.02183 0.00408 0.000515 -0.003713"/>
          <joint name="joint2" range="-2.059 2.0944" class="size1"/>
          <geom class="visual" mesh="link2_white_vis" material="white"/>
          <geom class="visual" mesh="link2_silver_vis" material="silver"/>
          <geom class="collision" mesh="xarm6_link2_col_00"/>
          <geom class="collision" mesh="xarm6_link2_col_01"/>
          <geom class="collision" mesh="xarm6_link2_col_02"/>
          <geom class="collision" mesh="xarm6_link2_col_03"/>
          <geom class="collision" mesh="xarm6_link2_col_04"/>
          <body name="link3" pos="0.0535 -0.2845 0">
            <inertial pos="0.0714 0.1268 0.0109" mass="2.019"
              fullinertia="0.007602 0.004263 0.00708 -0.001578 0.000916 0.0021"/>
            <joint name="joint3" range="-3.927 0.19198" class="size2"/>
            <geom class="visual" mesh="link3_white_vis" material="white"/>
            <geom class="visual" mesh="link3_silver_vis" material="silver"/>
            <geom class="collision" mesh="xarm6_link3_col_00"/>
            <geom class="collision" mesh="xarm6_link3_col_01"/>
            <geom class="collision" mesh="xarm6_link3_col_02"/>
            <geom class="collision" mesh="xarm6_link3_col_03"/>
            <geom class="collision" mesh="xarm6_link3_col_04"/>
            <body name="link4" pos="0.0775 0.3425 0" quat="0.707105 -0.707108 0 0">
              <inertial pos="0.000185 0.01466 -0.02197" mass="1.361"
                fullinertia="0.004888 0.004184 0.001731 -1.2e-05 -4e-06 7e-06"/>
              <joint name="joint4" class="size2"/>
              <geom class="visual" mesh="link4_white_vis" material="white"/>
              <geom class="visual" mesh="link4_silver_vis" material="silver"/>
              <geom class="collision" mesh="xarm6_link4_col_00"/>
              <geom class="collision" mesh="xarm6_link4_col_01"/>
              <geom class="collision" mesh="xarm6_link4_col_02"/>
              <geom class="collision" mesh="xarm6_link4_col_03"/>
              <geom class="collision" mesh="xarm6_link4_col_04"/>
              <body name="link5" quat="0.707105 0.707108 0 0">
                <inertial pos="0.0682 0.03342 0.00263" mass="1.345"
                  fullinertia="0.001622 0.00171 0.002286 -0.000335 0.000246 0.000114"/>
                <joint name="joint5" range="-1.69297 3.14159" class="size2"/>
                <geom class="visual" mesh="link5_white_vis" material="white"/>
                <geom class="visual" mesh="link5_silver_vis" material="silver"/>
                <geom class="collision" mesh="xarm6_link5_col_00"/>
                <geom class="collision" mesh="xarm6_link5_col_01"/>
                <body name="link6" pos="0.076 0.097 0" quat="0.707105 -0.707108 0 0">
                  <inertial pos="0.00084 -0.00359 -0.01326" mass="0.173"
                    fullinertia="0.000112 9e-05 0.00018 0 0 -3e-06"/>
                  <joint name="joint6" class="size3"/>
                  <geom class="visual" mesh="link6_white_vis" material="white"/>
                  <geom class="visual" mesh="link6_silver_vis" material="silver"/>
                  <geom class="visual" mesh="link6_black_vis" material="black"/>
                  <geom class="collision" mesh="xarm6_link6_col_00"/>
                  <site name="attachment_site" pos="0 0 0"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <contact>
    <exclude body1="link_base" body2="link1"/>
    <exclude body1="link1" body2="link2"/>
    <exclude body1="link2" body2="link3"/>
    <exclude body1="link3" body2="link4"/>
    <exclude body1="link4" body2="link5"/>
    <exclude body1="link5" body2="link6"/>
  </contact>

  <actuator>
    <general name="act1" joint="joint1" class="size1" forcerange="-179.4445 179.4445"/>
    <general name="act2" joint="joint2" class="size1" ctrlrange="-2.059 2.0944" forcerange="-179.4445 179.4445"/>
    <general name="act3" joint="joint3" class="size2" ctrlrange="-3.927 0.19198" forcerange="-92 92"/>
    <general name="act4" joint="joint4" class="size2" forcerange="-81.558 81.558"/>
    <general name="act5" joint="joint5" class="size2" ctrlrange="-1.69297 3.14159" forcerange="-30.6 30.6"/>
    <general name="act6" joint="joint6" class="size3" forcerange="-30.6 30.6"/>
  </actuator>

  <keyframe>
    <key name="home" qpos="0 0 0 0 0 0" ctrl="0 0 0 0 0 0"/>
    <key name="ready" qpos="0 0 0 0 0 0" ctrl="0 0 0 0 0 0"/>
  </keyframe>
</mujoco>
