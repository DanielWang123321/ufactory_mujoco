    <mesh name="link5_silver_vis" file="xarm7/visual/link5_silver.obj" inertia="shell"/>
    <mesh name="link6_white_vis" file="xarm7/visual/link6_white.obj"/>
    <mesh name="link6_silver_vis" file="xarm7/visual/link6_silver.obj" inertia="shell"/>
    <mesh name="link7_white_vis" file="../../xarm6/assets/xarm6/visual/link6_white.obj" inertia="shell"/>
    <mesh name="link7_silver_vis" file="../../xarm6/assets/xarm6/visual/link6_silver.obj" inertia="shell"/>
    <mesh name="link7_black_vis" file="../../xarm6/assets/xarm6/visual/link6_black.obj" inertia="shell"/>

    <!-- Multi-convex collision STLs -->
    <mesh name="xarm7_link1_col_00" file="xarm7/collision/xarm7_link1_col_00.stl"/>
    <mesh name="xarm7_link1_col_01" file="xarm7/collision/xarm7_link1_col_01.stl"/>
    <mesh name="xarm7_link2_col_00" file="xarm7/collision/xarm7_link2_col_00.stl"/>
    <mesh name="xarm7_link2_col_01" file="xarm7/collision/xarm7_link2_col_01.stl"/>
    <mesh name="xarm7_link2_col_02" file="xarm7/collision/xarm7_link2_col_02.stl"/>
    <mesh name="xarm7_link2_col_03" file="xarm7/collision/xarm7_link2_col_03.stl"/>
    <mesh name="xarm7_link2_col_04" file="xarm7/collision/xarm7_link2_col_04.stl"/>
    <mesh name="xarm7_link3_col_00" file="xarm7/collision/xarm7_link3_col_00.stl"/>
    <mesh name="xarm7_link3_col_01" file="xarm7/collision/xarm7_link3_col_01.stl"/>
    <mesh name="xarm7_link3_col_02" file="xarm7/collision/xarm7_link3_col_02.stl"/>
    <mesh name="xarm7_link3_col_03" file="xarm7/collision/xarm7_link3_col_03.stl"/>
    <mesh name="xarm7_link4_col_00" file="xarm7/collision/xarm7_link4_col_00.stl"/>
    <mesh name="xarm7_link4_col_01" file="xarm7/collision/xarm7_link4_col_01.stl"/>
    <mesh name="xarm7_link4_col_02" file="xarm7/collision/xarm7_link4_col_02.stl"/>
    <mesh name="xarm7_link4_col_03" file="xarm7/collision/xarm7_link4_col_03.stl"/>
    <mesh name="xarm7_link4_col_04" file="xarm7/collision/xarm7_link4_col_04.stl"/>
    <mesh name="xarm7_link5_col_00" file="xarm7/collision/xarm7_link5_col_00.stl"/>
    <mesh name="xarm7_link5_col_01" file="xarm7/collision/xarm7_link5_col_01.stl"/>
    <mesh name="xarm7_link5_col_02" file="xarm7/collision/xarm7_link5_col_02.stl"/>
