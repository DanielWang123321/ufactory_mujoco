          <geom class="collision" mesh="xarm7_link2_col_04"/>
          <body name="link3" pos="0 -0.293 0" quat="0.707105 0.707108 0 0">
            <inertial pos="0.0464 -0.022 -0.00804" mass="2"
              fullinertia="0.004105 0.0034706 0.0038088 0.0003006 -0.00073 0.0003843"/>
            <joint name="joint3" class="size2"/>
            <geom class="visual" mesh="link3_white_vis" material="white"/>
